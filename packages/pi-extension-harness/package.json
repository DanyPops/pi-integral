{
  "name": "@danypops/pi-extension-harness",
  "version": "0.4.0",
  "description": "A lightweight, in-process test host for Pi extensions -- unit-test hooks, tools, and commands without booting a real AgentSession, LLM, or I/O. Analogous to ESLint's RuleTester: ships the testing primitives so extension authors stop hand-rolling ad-hoc fake ExtensionAPI objects.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock-pi-cli": "./src/mock-pi-cli.mjs"
  },
  "files": ["src", "dist", "README.md", "LICENSE"],
  "keywords": ["pi", "pi-extension", "testing", "test-harness", "jiti"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test test",
    "format": "biome format --write ."
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "typebox": "^1.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/pi-integral.git",
    "directory": "packages/pi-extension-harness"
  },
  "homepage": "https://github.com/DanyPops/pi-integral/tree/main/packages/pi-extension-harness#readme",
  "bugs": {
    "url": "https://github.com/DanyPops/pi-integral/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
