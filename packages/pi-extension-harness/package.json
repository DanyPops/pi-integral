{
	"name": "@danypops/pi-extension-harness",
	"version": "0.1.0",
	"description": "A lightweight, in-process test host for Pi extensions -- unit-test hooks, tools, and commands without booting a real AgentSession, LLM, or I/O. Analogous to ESLint's RuleTester: ships the testing primitives so extension authors stop hand-rolling ad-hoc fake ExtensionAPI objects.",
	"type": "module",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./mock-pi-cli": "./src/mock-pi-cli.mjs"
	},
	"files": ["src", "dist", "README.md", "LICENSE"],
	"keywords": ["pi", "pi-extension", "testing", "test-harness", "jiti"],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "bun run build && bun test test"
	},
	"dependencies": {
		"jiti": "^2.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@types/node": "^22.0.0",
		"bun-types": "^1.3.0",
		"typebox": "^1.1.0",
		"typescript": "^5.7.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/pi-extension-harness.git"
	},
	"homepage": "https://github.com/DanyPops/pi-extension-harness#readme",
	"bugs": {
		"url": "https://github.com/DanyPops/pi-extension-harness/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
