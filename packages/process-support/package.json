{
	"name": "@danypops/process-support",
	"version": "0.1.0",
	"description": "Shared process-spawning primitives: bounded stderr capture, graceful-then-forceful (SIGTERM-then-SIGKILL) shutdown, and NDJSON/line-buffered stdout parsing. Not Pi-specific -- extracted from real duplication between pi-process-harness's spawnRealPiProcess and spawnCompanionDaemon.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/pi-integral.git",
		"directory": "packages/process-support"
	},
	"homepage": "https://github.com/DanyPops/pi-integral/tree/main/packages/process-support#readme",
	"bugs": {
		"url": "https://github.com/DanyPops/pi-integral/issues"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "bun run build && bun test test",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^22.0.0",
		"bun-types": "latest",
		"typescript": "^5.9.2"
	},
	"files": ["src", "dist", "README.md", "LICENSE"],
	"keywords": ["process", "subprocess", "spawn", "shutdown", "ndjson"]
}
